{
  "name": "ask",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:api": "node scripts/with-test-db.mjs vitest run",
    "test:live": "node scripts/with-test-db.mjs --real-groq vitest run --config vitest.live.config.mts",
    "test:e2e": "playwright test",
    "check:server": "node scripts/with-test-db.mjs npm run build && node scripts/with-test-db.mjs next start --port 3200",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:test": "node scripts/with-test-db.mjs prisma migrate deploy"
  },
  "dependencies": {
    "@ai-sdk/groq": "4.0.84",
    "@ai-sdk/react": "4.0.177",
    "@date-fns/tz": "1.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@ui-sdk/core": "0.1.0-beta.3",
    "@ui-sdk/react": "0.1.0-beta.3",
    "@upstash/qstash": "2.13.0",
    "ai": "7.0.173",
    "arctic": "3.7.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.1.0"
  }
}
