generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled

  @@map("reminder_status")
}

model Reminder {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id")
  title       String
  description String?
  dueAt       DateTime       @map("due_at") @db.Timestamptz(3)
  timezone    String
  status      ReminderStatus @default(pending)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, dueAt])
  @@map("reminders")
}

// What Ask was used for on one day (UTC), for the daily limits. A visitor's row counts their questions;
// the "site" row counts every call to the model, from everyone together, and the tokens those calls used.
model DailyUsage {
  day        DateTime @db.Date
  subject    String
  questions  Int      @default(0)
  modelCalls Int      @default(0) @map("model_calls")
  tokens     Int      @default(0)

  @@id([day, subject])
  @@map("daily_usage")
}
