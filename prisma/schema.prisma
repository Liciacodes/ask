generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled

  @@map("reminder_status")
}

// What a reminder is about, for its colour and icon in the week. The same list as lib/categories.ts.
enum ReminderCategory {
  work
  health
  call
  message
  food
  travel
  exercise
  shopping
  hobby
  other

  @@map("reminder_category")
}

model Reminder {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id")
  title       String
  description String?
  dueAt       DateTime       @map("due_at") @db.Timestamptz(3)
  timezone    String
  status      ReminderStatus @default(pending)
  category    ReminderCategory @default(other)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  // The due time a QStash message is waiting for (lib/notifications/schedule.ts), so the daily cron doesn't
  // publish it again. A moved reminder no longer matches, and gets a new message.
  notifyScheduledFor DateTime? @map("notify_scheduled_for") @db.Timestamptz(3)

  @@index([userId, dueAt])
  @@index([status, dueAt])
  @@map("reminders")
}

// A browser that turned reminders on: where its push service takes notifications, and the keys to encrypt them.
// owner_id is a visitor id or a user id, like reminders.user_id, and moves with them on sign-in (lib/owner-move.ts).
model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId   String   @map("owner_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@map("push_subscriptions")
}

// What Ask was used for on one day (UTC), for the daily limits. A visitor's row counts their questions;
// the "site" row counts every call to the model, from everyone together, and the tokens those calls used.
model DailyUsage {
  day        DateTime @db.Date
  subject    String
  questions  Int      @default(0)
  modelCalls Int      @default(0) @map("model_calls")
  tokens     Int      @default(0)

  @@id([day, subject])
  @@map("daily_usage")
}

// Someone signed in with Google. A guest's reminders move to their account when they sign in, and from then
// on reminders.user_id holds this id instead of the visitor's.
model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSub String    @unique @map("google_sub")
  email     String
  name      String?
  picture   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions  Session[]

  @@map("users")
}

// A signed-in browser. The id is the SHA-256 of the token in its cookie, so the table alone can't sign anyone in.
model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}
