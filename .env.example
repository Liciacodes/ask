# Copy this file to .env.local and fill it in. Never commit .env.local.
# Use Neon's connection strings with connection pooling turned off,
# and add &connect_timeout=30 to each: a sleeping Neon branch can take a while to wake.

# Your real database: the Neon main branch.
DATABASE_URL=

# The test database: the Neon "test" branch. Tests empty its tables.
TEST_DATABASE_URL=

# The agent's model, on Groq (console.groq.com/keys). Only the server reads it.
GROQ_API_KEY=

# Daily limits on the agent, counted from midnight UTC. Leave them empty for 10 and 60.
# How many questions each visitor can ask a day; answering a preview card doesn't count.
ASK_VISITOR_QUESTIONS_PER_DAY=
# How many calls to Groq the whole site can make a day. 0 turns the agent off.
ASK_SITE_GROQ_CALLS_PER_DAY=
