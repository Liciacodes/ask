# Copy this file to .env.local and fill it in. Never commit .env.local.
# Use Neon's connection strings with connection pooling turned off,
# and add &connect_timeout=30 to each: a sleeping Neon branch can take a while to wake.

# Your real database: the Neon main branch.
DATABASE_URL=

# The test database: the Neon "test" branch. Tests empty its tables.
TEST_DATABASE_URL=

# The agent's model, on Groq (console.groq.com/keys). Only the server reads it.
GROQ_API_KEY=

# Daily limits on the agent, counted from midnight UTC. Leave them empty for 10 and 60.
# How many questions each visitor can ask a day; answering a preview card doesn't count.
ASK_VISITOR_QUESTIONS_PER_DAY=
# How many calls to Groq the whole site can make a day. 0 turns the agent off.
ASK_SITE_GROQ_CALLS_PER_DAY=

# Reminder notifications. Without ASK_SITE_URL and QSTASH_TOKEN nothing is scheduled; without the VAPID keys
# nothing is sent. Make the VAPID keys with: npx web-push generate-vapid-keys
# The public key is the only one the browser sees.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# From console.upstash.com/qstash. QSTASH_URL is the address shown there for your region, or the local dev
# server's (npx @upstash/qstash-cli dev) when trying it on your own computer.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# The address QStash calls back: https://ask-pi-pearl.vercel.app live, http://localhost:3000 on your computer.
ASK_SITE_URL=
# Any long random text. Vercel sends it to the daily cron; nothing else gets in without it.
CRON_SECRET=
